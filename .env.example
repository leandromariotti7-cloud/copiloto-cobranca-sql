# Copie para .env e preencha para usar o Claude de verdade.
# Sem credencial, o copiloto roda em modo OFFLINE (regras determinísticas).

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). Default: claude-opus-5. Para baratear: claude-sonnet-5
# COPILOTO_MODEL=claude-sonnet-5

# Force o modo offline mesmo com chave presente (demo/CI determinística):
# COPILOTO_OFFLINE=1
